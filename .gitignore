# macOS
.DS_Store

# Debug
debug
__debug_bin*

# Local binaries generated by `go build` in example directories.
# Each example is its own module whose binary takes the module's name, so the
# pattern covers every example — including ones added later. Enumerating them
# one by one drifted before: the list stopped at 09 and left the binaries of
# 08 and 10-16 untracked.
examples/*/[a-z]*[a-z]
# Keep everything that has an extension, but only when the name starts with a
# letter or digit: a bare `!examples/*/*.*` would also un-ignore dotfiles and
# put a local examples/<name>/.env back on the table for an accidental commit.
!examples/*/[a-z0-9]*.*
!examples/*/*/
